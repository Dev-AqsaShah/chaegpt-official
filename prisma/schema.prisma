// Chae GPT — Prisma schema
// Dev: SQLite  |  Prod: switch DATABASE_URL to a postgres:// connection string

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ─── Auth ────────────────────────────────────────────────────────────────────

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String    @unique
  hashedPassword String?
  role           Role      @default(CUSTOMER)
  emailVerified  DateTime?
  image          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  accounts     Account[]
  sessions     Session[]
  addresses    Address[]
  orders       Order[]
  reviews      Review[]
  reservations Reservation[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum Role {
  CUSTOMER
  ADMIN
}

// ─── Address ─────────────────────────────────────────────────────────────────

model Address {
  id        String   @id @default(cuid())
  userId    String
  label     String   @default("Home")
  street    String
  area      String?
  city      String   @default("Jamshoro")
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]
}

// ─── Menu ────────────────────────────────────────────────────────────────────

model Category {
  id        String     @id @default(cuid())
  name      String     @unique
  slug      String     @unique
  emoji     String?
  sortOrder Int        @default(0)
  items     MenuItem[]
}

model MenuItem {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  price       Int
  image       String?
  categoryId  String
  spiceLevel  Int      @default(0)
  tags        String   @default("")
  isAvailable Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category   Category         @relation(fields: [categoryId], references: [id])
  options    MenuItemOption[]
  orderItems OrderItem[]
}

model MenuItemOption {
  id         String @id @default(cuid())
  menuItemId String
  groupName  String
  label      String
  priceDelta Int    @default(0)

  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
}

// ─── Orders ──────────────────────────────────────────────────────────────────

model Order {
  id              String        @id @default(cuid())
  orderNumber     String        @unique
  userId          String?
  guestName       String?
  guestPhone      String?
  guestEmail      String?
  status          OrderStatus   @default(PENDING)
  type            OrderType     @default(DELIVERY)
  subtotal        Int
  deliveryFee     Int           @default(0)
  tip             Int           @default(0)
  discount        Int           @default(0)
  total           Int
  paymentMethod   PaymentMethod @default(COD)
  paymentStatus   PaymentStatus @default(UNPAID)
  couponCode      String?
  notes           String?
  addressId       String?
  deliveryAddress String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user    User?       @relation(fields: [userId], references: [id])
  address Address?    @relation(fields: [addressId], references: [id])
  items   OrderItem[]
}

model OrderItem {
  id              String @id @default(cuid())
  orderId         String
  menuItemId      String
  nameSnapshot    String
  unitPrice       Int
  quantity        Int
  selectedOptions String @default("")
  lineTotal       Int

  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id])
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum OrderType {
  DELIVERY
  PICKUP
}

enum PaymentMethod {
  COD
  MOCK_CARD
  STRIPE
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

// ─── Reservations ────────────────────────────────────────────────────────────

model Reservation {
  id        String            @id @default(cuid())
  userId    String?
  name      String
  phone     String
  email     String?
  date      String
  time      String
  partySize Int
  notes     String?
  status    ReservationStatus @default(PENDING)
  createdAt DateTime          @default(now())

  user User? @relation(fields: [userId], references: [id])
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

// ─── Reviews ─────────────────────────────────────────────────────────────────

model Review {
  id        String   @id @default(cuid())
  userId    String?
  guestName String?
  rating    Int
  comment   String?
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])
}

// ─── Coupons ─────────────────────────────────────────────────────────────────

model Coupon {
  id        String     @id @default(cuid())
  code      String     @unique
  type      CouponType @default(PERCENTAGE)
  value     Int
  minOrder  Int        @default(0)
  maxUses   Int?
  usedCount Int        @default(0)
  active    Boolean    @default(true)
  expiresAt DateTime?
  createdAt DateTime   @default(now())
}

enum CouponType {
  PERCENTAGE
  FLAT
}
